# Porta da API
PORT=3001

# PostgreSQL (Prisma). Se ficar vazia, a API sobe com repositórios EM MEMÓRIA (apenas desenvolvimento).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/escala5x2

# Segredo do JWT. Em produção é OBRIGATÓRIO e deve ter 32+ caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Em desenvolvimento, se ausente, a API usa um segredo efêmero aleatório.
JWT_SECRET=troque-isto-por-um-segredo-longo-e-aleatorio

# Origens de navegador permitidas (CORS), separadas por vírgula.
# Em desenvolvimento o padrão é http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# URL pública do front-end (usada nos links do Magic Link).
PUBLIC_APP_URL=https://planilhaescala5x2.com.br

# Atrás de proxy reverso (Nginx, Render etc.): número de proxies confiáveis (para o rate limit ver o IP real).
# Aceita true, false ou um inteiro (ex.: 1). Outro valor impede a API de subir.
# TRUST_PROXY=1
